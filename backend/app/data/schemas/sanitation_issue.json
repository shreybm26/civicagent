{
  "service_id": "sanitation_issue",
  "schema_version": "1.0",
  "service_name": "Sanitation Complaint",
  "description": "Report a sanitation or public hygiene issue",
  "department": "Sanitation Services",
  "keywords": [
    "sanitation",
    "sewage",
    "drain",
    "toilet",
    "hygiene",
    "स्वच्छता",
    "नाली"
  ],
  "fields": [
    {
      "id": "location",
      "type": "location",
      "required": true
    },
    {
      "id": "description",
      "type": "text",
      "required": true
    },
    {
      "id": "issue_type",
      "type": "choice",
      "required": true,
      "options": [
        "sewage",
        "drain",
        "public_hygiene",
        "other"
      ]
    },
    {
      "id": "duration",
      "type": "text",
      "required": false
    },
    {
      "id": "photo",
      "type": "image",
      "required": false
    },
    {
      "id": "additional_details",
      "type": "text",
      "required": false,
      "image_derivable": true
    }
  ],
  "submission": {
    "endpoint": "/api/submit",
    "id_prefix": "CIV"
  }
}
