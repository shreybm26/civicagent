{
  "service_id": "road_issue",
  "schema_version": "1.0",
  "service_name": "Road / Pothole Complaint",
  "description": "Report road damage, potholes, or surface deterioration",
  "department": "Roads & Infrastructure",
  "keywords": [
    "pothole",
    "pot hole",
    "road",
    "crack",
    "damage",
    "pavement",
    "asphalt",
    "surface",
    "hurt",
    "injured",
    "injury",
    "fell",
    "fall",
    "accident",
    "गड्ढा",
    "गड्ढे",
    "सड़क"
  ],
  "fields": [
    {
      "id": "location",
      "type": "location",
      "required": true
    },
    {
      "id": "description",
      "type": "text",
      "required": true
    },
    {
      "id": "severity",
      "type": "choice",
      "required": true,
      "options": ["low", "medium", "high"],
      "image_derivable": true
    },
    {
      "id": "photo",
      "type": "image",
      "required": false
    },
    {
      "id": "additional_details",
      "type": "text",
      "required": false,
      "image_derivable": true
    },
    {
      "id": "landmark",
      "type": "text",
      "required": false,
      "image_derivable": true
    }
  ],
  "submission": {
    "endpoint": "/api/submit",
    "id_prefix": "CIV"
  }
}
