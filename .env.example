GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=120
PROVIDER_MODE=mock
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
MAX_SESSIONS=100
MEDIA_DATABASE_PATH=backend/data/civicagent-media.db
IMAGE_CONFIDENCE_THRESHOLD=0.7

# Optional OpenRouter vision for image analysis only (router/collector stay on Gemini/mock).
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_TIMEOUT_SECONDS=120

# Optional tracking persistence. Local/default is SQLite (see GRIEVANCE_DATABASE_PATH).
# For Railway, create a Supabase project and set these three — never put them in the frontend:
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TRACKING_PEPPER=generate-a-long-random-string
GRIEVANCE_DATABASE_PATH=backend/data/civicagent-grievances.db
TRACKING_PEPPER=civicagent-demo-tracking

# Optional acknowledgement email via Resend. Without these, tracking still works
# and the UI shows why send is unavailable. Put the real key only in local .env
# or Railway Variables — never in git or chat.
# RESEND_API_KEY=re_xxxxxxxxx
# Resend's test sender. It can only deliver to the Resend account owner.
RESEND_FROM=CivicAgent Demo <onboarding@resend.dev>
# Public site URL used in the tracking link inside the email. If unset, the
# request host is used (fine on Railway).
# PUBLIC_BASE_URL=https://YOUR-SERVICE.up.railway.app

# mock keeps the deterministic contest demo. Set PROVIDER_MODE=gemini or auto
# and GEMINI_API_KEY only if you want live model proposals with mock fallback.
# Set OPENROUTER_API_KEY to route image analysis through OpenRouter instead of Gemini.

# Production (Railway) serves the React app from the same origin, so leave this
# unset. Only set it if the frontend is hosted separately, e.g. Vercel:
# VITE_API_URL=https://your-service.up.railway.app
